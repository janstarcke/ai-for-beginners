#!/usr/bin/env bash
#
# pre-push hook — keeps the /secret-import-history timeline fresh.
#
# WHY: client/src/data/gitHistory.generated.ts is a COMMITTED, auto-generated
# file (the Docker build has no .git, so the page can't read git live). If
# content commits land without regenerating it, the hidden import-history page
# silently freezes — exactly the May-14→May-18 staleness this hook prevents.
#
# WHAT IT DOES:
#   1. Regenerates gitHistory.generated.ts from local git log.
#   2. If only the `gitHistoryGeneratedAt` timestamp changed (cosmetic) →
#      discards the churn and lets the push through untouched.
#   3. If the actual commit list changed → auto-commits the refreshed file and
#      ABORTS the push, so you just `git push` once more and the catalog
#      commit ships too. (A pre-push hook cannot inject a commit into the
#      push already in flight — re-pushing is the correct, standard pattern.)
#
# Idempotent: a push with nothing new to catalog is NOT blocked.
#
# Install (once per clone): pnpm run setup:hooks
#   (sets git config core.hooksPath scripts/hooks)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GEN_FILE="client/src/data/gitHistory.generated.ts"

# Generator is plain Node — call it directly so the hook does not depend on
# pnpm being on PATH (GUI git clients often have a minimal env).
if ! node scripts/build-git-history.mjs >/dev/null 2>&1; then
  echo "[pre-push] WARN: build-git-history.mjs failed — pushing existing $GEN_FILE unchanged." >&2
  exit 0
fi

# Real change = any +/- diff line that is NOT the generatedAt timestamp and
# NOT a diff file-header line.
REAL_CHANGES="$(git diff --no-color -- "$GEN_FILE" \
  | grep -E '^[+-]' \
  | grep -vE '^(\+\+\+|---)' \
  | grep -v 'gitHistoryGeneratedAt' \
  || true)"

if [ -z "$REAL_CHANGES" ]; then
  # Only the timestamp moved (or nothing) — cosmetic. Discard and allow push.
  git checkout -- "$GEN_FILE" 2>/dev/null || true
  exit 0
fi

# The commit list genuinely changed → catalog it and stop the push.
git add "$GEN_FILE"
git commit -m "chore(history): auto-regenerate import history (pre-push hook)" \
  -m "Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>" \
  -- "$GEN_FILE" >/dev/null

cat >&2 <<'MSG'

  ────────────────────────────────────────────────────────────────
  Import-Chronik war veraltet.

  → gitHistory.generated.ts wurde automatisch regeneriert UND als
    eigener Commit erstellt.

  Dieser Push wurde bewusst gestoppt (der neue Commit kann nicht
  nachträglich in einen bereits laufenden Push). Bitte einfach:

        git push

  erneut ausführen — dann geht der Katalog-Commit mit raus.
  ────────────────────────────────────────────────────────────────

MSG
exit 1
